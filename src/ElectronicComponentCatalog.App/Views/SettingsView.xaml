<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrokenBrainSoftware.Utilities.ElectronicComponentCatalog.App.ViewModels"
             x:Class="BrokenBrainSoftware.Utilities.ElectronicComponentCatalog.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <StackLayout Padding="20">
        <Label Text="Settings"
               FontAttributes="Bold"
               FontSize="18">
        <Label Text="Database Path:">
        <Entry Text="{Binding DatabasePath}"
               IsReadOnly="True">
        <Button Text="Open Folder"
                Command="{Binding OpenFolderCommand}">
    </StackLayout>
</ContentPage>