<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrokenBrainSoftware.Utilities.ElectronicComponentCatalog.App.ViewModels"
             x:Class="BrokenBrainSoftware.Utilities.ElectronicComponentCatalog.App.Views.MainPage"
             x:DataType="vm:BrokenBrainSoftware.Utilities.ElectronicComponentCatalog.App.MainiewModel"
             Title="Electronic Component Catalog">
    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="200,*">
        <!-- Sidebar Navigation -->
        <StackLayout Grid.RowSpan="2"
                     Grid.Column="0"
                     BackgroundColor="{StaticResource SecondaryAccentColor}"
                     Padding="10"
                     Spacing="15">
            <Label Text="Electronic Component Catalog"
                   FontSize="18"
                   TextColor="{StaticResource ForegroundColor}"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold"/>
            <Button Text="Catalog"
                    Command="{Binding NavigateCatalogCommand}"/>
            <Button Text="Add Part"
                    Command="{Binding NavigateAddPartCommand}"/>
            <Button Text="Bulk Add"
                    Command="{Binding NavigateBulkAddCommand}"/>
            <Button Text="Search"
                    Command="{Binding NavigateSearchCommand}"/>
            <Button Text="Settings"
                    Command="{Binding NavigateSettingsCommand}"/>
        </StackLayout>
        <!-- Content Area -->
        <ContentView Grid.Column="1"
                     x:Name="ContentRegion"
                     BackgroundColor="{StaticResource BackgroundColor}"/>
    </Grid>
</ContentPage>