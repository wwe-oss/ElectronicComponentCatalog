<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrokenBrainSoftware.Utilities.ElectronicComponentCatalog.App.ViewModels"
             x:Class="BrokenBrainSoftware.Utilities.ElectronicComponentCatalog.App.Views.AddPartView"
             x:DataType="vm:AddPartViewModel">
    <ScrollView>
        <StackLayout Padding="20"
                     Spacing="10">
            <Label Text="Add New Component"
                   FontAttributes="Bold"
                   FontSize="18">
            <Entry Placeholder="Name"
                   Text="{Binding Name}">
            <Entry Placeholder="Common Name"
                   Text="{Binding CommonName}">
            <Entry Placeholder="Category"
                   Text="{Binding CategoryName}">
            <Entry Placeholder="Value (e.g. 10k)"
                   Text="{Binding Value}">
            <Entry Placeholder="Unit (e.g. Ohm)"
                   Text="{Binding Unit}">
            <Entry Placeholder="Quantity"
                   Text="{Binding Quantity}"
                   Keyboard="Numeric">
            <Button Text="Add Component"
                    Command="{Binding AddCommand}">
        </StackLayout>
    </ScrollView>
</ContentPage>