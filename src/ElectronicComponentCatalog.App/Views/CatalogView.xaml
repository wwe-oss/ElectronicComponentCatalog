<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BrokenBrainSoftware.Utilities.ElectronicComponentCatalog.App.ViewModels"
             x:Class="BrokenBrainSoftware.Utilities.ElectronicComponentCatalog.App.Views.CatalogView"
             x:DataType="vm:CatalogViewModel">
    <StackLayout Padding="20"
                 Spacing="10">
        <Label Text="Component Catalog"
               FontAttributes="Bold"
               FontSize="18"/>
        <SearchBar Placeholder="Search components..."
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding SearchCommand}"/>
        <CollectionView ItemsSource="{Binding Components}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10"
                           Margin="5"
                           BorderColor="{StaticResource SecondaryAccentColor}">
                        <StackLayout>
                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding Category.Name}"
                                   FontSize="12" />
                            <Label Text="{Binding QuantityOnHand, StringFormat='Qty: {0}'}"
                                   FontSize="12" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>