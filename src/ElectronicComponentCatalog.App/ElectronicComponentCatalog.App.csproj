<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>
            net10.0-windows10.0.19041.0
        </TargetFramework>
        <OutputType>
            Exe
        </OutputType>
        <RootNamespace>
            BrokenBrainSoftware.Utilities.ElectronicComponentCatalog.App
        </RootNamespace>
        <UseMaui>
            true
        </UseMaui>
        <SingleProject>
            true
        </SingleProject>
        <ImplicitUsings>
            enable
        </ImplicitUsings>
        <Nullable>
            enable
        </Nullable>
        <ApplicationTitle>
            Electronic Component Catalog
        </ApplicationTitle>
        <SupportedOSPlatformVersion>
            10.0.17763.0
        </SupportedOSPlatformVersion>
        <ApplicationId>
            com.brokenbrainsoftware.utilities.electroniccomponentcatalog.app
        </ApplicationId>
        <ApplicationDisplayVersion>
            1.0.0
        </ApplicationDisplayVersion>
        <ApplicationVersion>
            1
        </ApplicationVersion>
    </PropertyGroup>
    <ItemGroup>
        <MauiFont Include="Resources\\Fonts\\*"/>
        <MauiImage Include="Resources\\Images\\*"/>
        <MauiResource Include="Resources\\Styles\\*"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm"
                          Version="8.4.0"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"
                          Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Configuration"
                          Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json"
                          Version="10.0.0"/>
        <PackageReference Include="Microsoft.Maui.Controls"
                          Version="10.0.11"/>
        <PackageReference Include="Microsoft.Maui.Essentials"
                          Version="10.0.11"/>
    </ItemGroup>
</Project>  